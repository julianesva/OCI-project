e, story_Points=7}, ToDoItem{id=83, title='Initial code deployment.', moduleId=41, description='Time to understand the code provided by oracle and do the initial code deployment in order to understand all the OCI concepts studied. ', dateLimit=null, responsible=1, endingDate=null, estimatedTime=4, actualTime=5, creation_ts=2025-04-05T14:50:06.709560-06:00, done=true, story_Points=8}, ToDoItem{id=84, title='OCI and Cloud Native Study', moduleId=41, description='Get close to the material related to OCI and cloud native in order to be able to solve the requirements that our client demand us. ', dateLimit=null, responsible=2, endingDate=null, estimatedTime=3, actualTime=5, creation_ts=2025-04-05T14:50:36.399389-06:00, done=true, story_Points=7}]}, Module{id=42, title='Getting Close To Oracle', body='Sprint to Start the initial phase of the development process', categoryId=1, status=1, severity=2, startDate=2025-04-05, dateLimit=2025-04-19, parentModule=null, tasks=[ToDoItem{id=87, title='Creation of work repo', moduleId=42, description='Creation of a work repo in which each member is capable of adding their own branches', dateLimit=null, responsible=1, endingDate=null, estimatedTime=1, actualTime=2, creation_ts=2025-04-05T14:53:31.323043-06:00, done=true, story_Points=2}, ToDoItem{id=90, title='Development of the final presentation 1st Period', moduleId=42, description='Time to develop the final presentation with the initial final project proposal, highlighting the changes that we consider that are going to improve the productivity of ORACLE teams and also are going to decrease the expenses of ORACLE as company. ', dateLimit=null, responsible=5, endingDate=null, estimatedTime=2, actualTime=3, creation_ts=2025-04-05T14:55:07.719128-06:00, done=true, story_Points=4}, ToDoItem{id=85, title='Initial task and responsabilities distribution.', moduleId=42, description='Time to start the initial distribution of responsibilities like do the initial code deployment, do the figma,