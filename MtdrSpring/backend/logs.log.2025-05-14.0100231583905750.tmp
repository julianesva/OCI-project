e=2, creation_ts=2025-04-05T15:34:48.380708-06:00, done=true, story_Points=5}]}, Module{id=22, title='Desarrollo del Login', body='Desarrollar la funcionalidad de login con autenticación de usuarios', categoryId=1, status=1, severity=2, startDate=2025-04-10, dateLimit=2025-04-17, parentModule=null, tasks=[ToDoItem{id=132, title='Research', moduleId=22, description='Investigar buenas prácticas para implementar un login seguro', dateLimit=null, responsible=1, endingDate=null, estimatedTime=2, actualTime=null, creation_ts=2025-04-25T02:56:07.724490-06:00, done=false, story_Points=2}, ToDoItem{id=133, title='Implement login', moduleId=22, description='Desarrollar la implementación de un login (componentes, creación de cuenta)', dateLimit=null, responsible=2, endingDate=null, estimatedTime=4, actualTime=4, creation_ts=2025-04-25T02:58:19.819203-06:00, done=true, story_Points=4}]}]]
