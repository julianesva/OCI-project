2025-04-25 02:41:47.746 TRACE 95910 --- [http-nio-8081-exec-2] m.m.a.RequestResponseBodyMethodProcessor : Writing [[Module{id=1, title='Oracle project', body='La primera versión del servicio debe de contener un Oracle Java Bot que automatice... \n1.2. Por temas de seguridad... \nEn la primera versión del servicio se solicita:\n○ El desarrollador pueda revisar sus tareas (To-do’s )\n○ El desarrollador pueda agregar/quitar una tarea (To-do’s )\n○ El manager puede ver las tareas de todo su equipo de desarrollo\n4. Manejo de Sprints / Features / Issues / Bugs\n5. Tasks con responsables tiempos estimados y tiempos reales\n6. Incluir capacitaciones individuales', categoryId=1, status=1, severity=2, startDate=2025-02-27, dateLimit=2025-03-15, parentModule=null, tasks=[ToDoItem{id=106, title='null', moduleId=1, description='Identify issues and improve system efficiency.', dateLimit=null, responsible=3, endingDate=null, estimatedTime=0, actualTime=2, creation_ts=2025-04-05T15:34:48.380708-06:00, done=true, story_Points=5}, ToDoItem{id=91, title='Task and responsibility administration for second and third period.', moduleId=1, description='Time to review every thing related to the project, create pending tasks and also make the second distribution of the responsibilities and tasks of the project.', dateLimit=null, responsible=1, endingDate=null, estimatedTime=2, actualTime=3, creation_ts=2025-04-05T14:56:33.220188-06:00, done=true, story_Points=5}]}, Module{id=41, title='Study and Preparation', body='Time to study all the material related to the course', categoryId=1, status=1, severity=2, startDate=2025-04-05, dateLimit=2025-04-19, parentModule=null, tasks=[ToDoItem{id=82, title='Java and Springboot Study', moduleId=41, description='Study about the technologies that are going to be necessary to develop the final solution for the client. ', dateLimit=null, responsible=2, endingDate=null, estimatedTime=4, actualTime=null, creation_ts=2025-04-05T14:49:35.489336-06:00, done=false, story_Points=7}, ToDoItem{id=84, title='OCI and Cloud Native Study', moduleId=41, description='Get close to the material related to OCI and cloud native in order to be able to solve the requirements that our client demand us. ', dateLimit=null, responsible=2, endingDate=null, estimatedTime=3, actualTime=5, creation_ts=2025-04-05T14:50:36.399389-06:00, done=true, story_Points=7}, ToDoItem{id=83, title='Initial code deployment.', moduleId=41, description='Time to understand the code provided by oracle and do the initial code deployment in order to understand all the OCI concepts studied. ', dateLimit=null, responsible=1, endingDate=null, estimatedTime=4, actualTime=5, creation_ts=2025-04-05T14:50:06.709560-06:00, done=true, story_Points=8}]}, Module{id=42, title='Getting Close To Oracle', body='Sprint to Start the initial phase of the development process', categoryId=1, status=1, severity=2, startDate=2025-04-05, dateLimit=2025-04-19, parentModule=null, tasks=[ToDoItem{id=87, title='Creation of work repo', moduleId=42, description='Creation of a work repo in which each member is capable of adding their own branches', dateLimit=null, responsible=1, endingDate=null, estimatedTime=1, actualTime=2, creation_ts=2025-04-05T14:53:31.323043-06:00, done=true, story_Points=2}, ToDoItem{id=89, title='Select the change to do for first period.', moduleId=42, description='Time to analyze the code provided by ORACLE and identify the opportunity areas that this can have. ', dateLimit=null, responsible=5, endingDate=null, estimatedTime=2, actualTime=6, creation_ts=2025-04-05T14:54:39.768315-06:00, done=true, story_Points=3}, ToDoItem{id=85, title='Initial task and responsabilities distribution.', moduleId=42, description='Time to start the initial distribution of responsibilities like do the initial code deployment, do the figma, start the documentation of these initial phases, etc. ', dateLimit=null, responsible=1, endingDate=null, estimatedTime=1, actualTime=1, creation_ts=2025-0