2025-05-14 19:02:23.817 TRACE 40045 --- [http-nio-8080-exec-5] m.m.a.RequestResponseBodyMethodProcessor : Writing [[Module{id=1, title='Oracle project', body='La primera versión del servicio debe de contener un Oracle Java Bot que automatice... \n1.2. Por temas de seguridad... \nEn la primera versión del servicio se solicita:\n○ El desarrollador pueda revisar sus tareas (To-do’s )\n○ El desarrollador pueda agregar/quitar una tarea (To-do’s )\n○ El manager puede ver las tareas de todo su equipo de desarrollo\n4. Manejo de Sprints / Features / Issues / Bugs\n5. Tasks con responsables tiempos estimados y tiempos reales\n6. Incluir capacitaciones individuales', categoryId=1, status=1, severity=2, startDate=2025-02-27, dateLimit=2025-03-15, parentModule=null, tasks=[ToDoItem{id=106, title='null', moduleId=1, description='Identify issues and improve system efficiency.', dateLimit=null, responsible=3, endingDate=null, estimatedTime=0, actualTime=2, creation_ts=2025-04-05T15:34:48.380708-06:00, done=true, story_Points=5}, ToDoItem{id=91, title='Task and responsibility administration for second and third period.', moduleId=1, description='Time to review every thing related to the project, create pending tasks and also make the second distribution of the responsibilities and tasks of the project.', dateLimit=null, responsible=1, endingDate=null, estimatedTime=2, actualTime=3, creation_ts=2025-04-05T14:56:33.220188-06:00, done=true, story_Points=5}]}, Module{id=41, title='Study and Preparation', body='Time to study all the material related to the course', categoryId=1, status=1, severity=2, startDate=2025-04-05, dateLimit=2025-04-19, parentModule=null, tasks=[ToDoItem{id=82, title='Java and Springboot Study', moduleId=41, description='Study about the technologies that are going to be necessary to develop the final solution for the client. ', dateLimit=null, responsible=2, endingDate=null, estimatedTime=4, actualTime=4, creation_ts=2025-04-05T14:49:35.489336-06:00, done=true, story_Points=7}, ToDoItem{id=84, title='OCI and Cloud Native Study', moduleId=41, description='Get close to the material related to OCI and cloud native in order to be able to solve the requirements that our client demand us. ', dateLimit=null, responsible=1, endingDate=null, estimatedTime=3, actualTime=5, creation_ts=2025-04-05T14:50:36.399389-06:00, done=true, story_Points=7}, ToDoItem{id=83, title='Initial code deployment.', moduleId=41, description='Time to understand the code provided by oracle and do the initial code deployment in order to understand all the OCI concepts studied. ', dateLimit=null, responsible=1, endingDate=null, estimatedTime=4, actualTime=5, creation_ts=2025-04-05T14:50:06.709560-06:00, done=true, story_Points=8}]}, Module{id=42, title='Getting Close To Oracle', body='Sprint to Start the initial phase of the development process', categoryId=1, status=1, severity=2, startDate=2025-04-05, dateLimit=2025-04-19, parentModule=null, tasks=[ToDoItem{id=87, title='Creation of work repo', moduleId=42, description='Creation of a work repo in which each member is capable of adding their own branches', dateLimit=null, responsible=1, endingDate=null, estimatedTime=1, actualTime=2, creation_ts=2025-04-05T14:53:31.323043-06:00, done=true, story_Points=2}, ToDoItem{id=90, title='Development of the final presentation 1st Period', moduleId=42, description='Time to develop the final presentation with the initial final project proposal, highlighting the changes that we consider that are going to improve the productivity of ORACLE teams and also are going to decrease the expenses of ORACLE as company. ', dateLimit=null, responsible=5, endingDate=null, estimatedTime=2, actualTime=3, creation_ts=2025-04-05T14:55:07.719128-06:00, done=true, story_Points=4}, ToDoItem{id=88, title='Development of Figma', moduleId=42, description='Create a Figma that matches the design of the project we aim to develop for Oracle', dateLimit=null, responsible=4, endingDate=null, estimat