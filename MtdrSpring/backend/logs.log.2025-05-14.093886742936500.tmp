2025-05-14 19:02:07.992 TRACE 40045 --- [http-nio-8080-exec-9] m.m.a.RequestResponseBodyMethodProcessor : Writing [[Module{id=1, title='Oracle project', body='La primera versión del servicio debe de contener un Oracle Java Bot que automatice... \n1.2. Por temas de seguridad... \nEn la primera versión del servicio se solicita:\n○ El desarrollador pueda revisar sus tareas (To-do’s )\n○ El desarrollador pueda agregar/quitar una tarea (To-do’s )\n○ El manager puede ver las tareas de todo su equipo de desarrollo\n4. Manejo de Sprints / Features / Issues / Bugs\n5. Tasks con responsables tiempos estimados y tiempos reales\n6. Incluir capacitaciones individuales', categoryId=1, status=1, severity=2, startDate=2025-02-27, dateLimit=2025-03-15, parentModule=null, tasks=[ToDoItem{id=106, title='null', moduleId=1, description='Identify issues and improve system efficiency.', dateLimit=null, responsible=3, endingDate=null, estimatedTime=0, actualTime=2, creation_ts=2025-04-05T15:34:48.380708-06:00, done=true, story_Points=5}, ToDoItem{id=91, title='Task and responsibility administration for second and third period.', moduleId=1, description='Time to review every thing related to the project, create pending tasks and also make the second distribution of the responsibilities and tasks of the project.', dateLimit=null, responsible=1, endingDate=null, estimatedTime=2, actualTime=3, creation_ts=2025-04-05T14:56:33.220188-06:00, done=true, story_Points=5}]}, Module{id=41, title='Study and Preparation', body='Time to study all the material related to the course', categoryId=1, status=1, severity=2, startDate=2025-04-05, dateLimit=2025-04-19, parentModule=null, tasks=[ToDoItem{id=84, title='OCI and Cloud Native Study', moduleId=41, description='Get close to the material related to OCI and cloud native in order to be able to solve the requirements that our client demand us. ', dateLimit=null, responsible=1, endingDate=null, estimatedTime=3, actualTime=5, creation_ts=2025-04-05T14:50:36.399389-06:00, done=true, story_Points=7}, ToDoItem{id=83, title='Initial code deployment.', moduleId=41, description='Time to understand the code provided by oracle and do the initial code deployment in order to understand all the OCI concepts studied. ', dateLimit=null, responsible=1, endingDate=null, estimatedTime=4, actualTime=5, creation_ts=2025-04-05T14:50:06.709560-06:00, done=true, story_Points=8}, ToDoItem{id=82, title='Java and Springboot Study', moduleId=41, description='Study about the technologies that are going to be necessary to develop the final solution for the client. ', dateLimit=null, responsible=2, endingDate=null, estimatedTime=4, actualTime=4, creation_ts=2025-04-05T14:49:35.489336-06:00, done=true, story_Points=7}]}, Module{id=42, title='Getting Close To Oracle', body='Sprint to Start the initial phase of the development process', categoryId=1, status=1, severity=2, startDate=2025-04-05, dateLimit=2025-04-19, parentModule=null, tasks=[ToDoItem{id=89, title='Select the change to do for first period.', moduleId=42, description='Time to analyze the code provided by ORACLE and identify the opportunity areas that this can have. ', dateLimit=null, responsible=5, endingDate=null, estimatedTime=2, actualTime=6, creation_ts=2025-04-05T14:54:39.768315-06:00, done=true, story_Points=3}, ToDoItem{id=85, title='Initial task and responsabilities distribution.', moduleId=42, description='Time to start the initial distribution of responsibilities like do the initial code deployment, do the figma, start the documentation of these initial phases, etc. ', dateLimit=null, responsible=1, endingDate=null, estimatedTime=1, actualTime=1, creation_ts=2025-04-05T14:51:16.386314-06:00, done=true, story_Points=3}, ToDoItem{id=90, title='Development of the final presentation 1st Period', moduleId=42, description='Time to develop the final presentation with the initial final project proposal, highlighting the changes that we consider that are going to improve the productivity of ORACLE teams and also are going to decrease the expenses of ORACLE as company. ', dateLimit=null, responsible=5, endingDate=null, estimatedTime=2, actualTime=3, creation_ts=2025-04-05T14:55:07.719128-06:00, done=true, story_Points=4}, ToDoItem{id=87, title='Creation of work repo', moduleId=42, description='Creation of a work repo in which each member is capable of adding their own branches', dateLimit=null, responsible=1, endingDate=null, estimatedTime=1, actualTime=2, creation_ts=2025-04-05T14:53:31.323043-06:00, done=true, story_Points=2}, ToDoItem{id=88, title='Development of Figma', moduleId=42, description='Create a Figma that matches the design of the project we aim to develop for Oracle', dateLimit=null, responsible=4, endingDate=null, estimatedTime=2, actualTime=4, creation_ts=2025-04-05T14:53:57.440739-06:00, done=true, story_Points=4}]}, Module{id=43, title='Front-End Development', body='REfacturing the front to look stetic', categoryId=1, status=1, severity=2, startDate=2025-04-05, dateLimit=2025-04-19, parentModule=null, tasks=[ToDoItem{id=97, title='Connect UI to API endpoints', moduleId=43, description='Enable data flow between the front end and back end.', dateLimit=null, responsible=4, endingDate=null, estimatedTime=3, actualTime=7, creation_ts=2025-04-05T15:10:58.428912-06:00, done=true, story_Points=6}, ToDoItem{id=131, title='Cre', moduleId=43, description='Desarrollar los componentes así como desglosar los datos para la visualización del key performance indicator de las horas trabajadas', dateLimit=2025-04-25, responsible=3, endingDate=null, estimatedTime=6, actualTime=4, creation_ts=2025-04-25T02:54:23.108325-06:00, done=true, story_Points=4}, ToDoItem{id=96, title='Develop main UI components', moduleId=43, description='Build key interface elements (e.g., navigation, forms, dashboards).', dateLimit=null, responsible=3, endingDate=null, estimatedTime=3, actualTime=6, creation_ts=2025-04-05T15:10:30.911519-06:00, done=true, story_Points=5},